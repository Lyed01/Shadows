  idDialogo: 
  lineas:
  - texto: "h-h-h HOLA!!\u2026 digo\u2026 hola. T-t\xFA tambi\xE9n quieres pasar,
      \xBFno?\r\n"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "s-sss\u2013soy\u2026 em\u2026 \xBFc\xF3mo me llamaba?\u2026\r\n"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: ...
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "\xA1AH, S\xCD! IGNOS. Quiero decir\u2026 soy Ignos, EL PORTADOR DE LA
      LLAMA.\r\n"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Lo siento\u2026 a veces me pierdo en mis fantas\xEDas.\r\n"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "En qu\xE9 est\xE1bamos\u2026? Ah, claro: quieres avanzar y volver a tu
      hogar, \xBFno es as\xED?\r"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Creo que puedo ayudarte\u2026 tengo algo que podr\xEDa servirte.\r\n"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  accionFinal:
