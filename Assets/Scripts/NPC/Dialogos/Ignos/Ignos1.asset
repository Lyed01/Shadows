    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "En que estabamos? ah claro quieres avanzar y volver a tu hogar \xBFno
      es as\xED?"
    retrato: {fileID: 3920333243450252084, guid: 7c6e5846f26250c4e9096b0db7c9e806, type: 3}
