--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f28f1ba5ca3e0d74c918894bf572cad2, type: 3}
  m_Name: Ignos1 1
  m_EditorClassIdentifier: 
  idDialogo: 
  lineas:
  - texto: "Ver\xE1s\u2026 hay lugares a los que necesitamos ir, pero no podemos
      llegar por nosotros mismos.\r"
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Por eso nuestros antepasados crearon la AbyssFlame.\r"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Esta peque\xF1a llamita puede ayudarte a resolver cualquier obst\xE1culo
      que encuentres.\r"
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Usarla es sencillo, casi como controlarte a ti mismo.\r"
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "En el Abismo siempre se quejaban de que corromp\xEDa todo el suelo cuando
      la usaba\u2026\r"
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "\xA1AH, CASI LO OLVIDO!\r"
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Por alguna raz\xF3n, la llama no se ve afectada por esas luces humanas\u2026"
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: Al menos no las amarillas.
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "C-creo que quieres probarla. Perd\xF3n\u2026 hace mucho que no hablo
      con nadie."
    retrato: {fileID: 0}
    nombreNPC: Ignos
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  accionFinal:
    tipo: 0
    habilidad: 0
    objetoActivar: {fileID: 0}
    activar: 1
    sonido: {fileID: 0}
    idPuerta: 
