%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f28f1ba5ca3e0d74c918894bf572cad2, type: 3}
  m_Name: Canuto
  m_EditorClassIdentifier: 
  idDialogo: 1
  lineas:
  - texto: "Cogh\u2026 cof\u2026 oh\u2026 por fin despiertas. Cre\xED que iba a morir
      solo aqu\xED.\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Voy a ponerte al d\xEDa antes de que llegue mi hora\u2026\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Mi nombre es\u2026 bah, ya no importa. Lo \xFAnico que debes saber es
      que estamos encerrados.\r"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Encerrados en estas malditas instalaciones humanas\u2026\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Cof\u2026 cof\u2026 siempre fr\xEDas, siempre vigil\xE1ndonos.\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Casi puedo oler la humedad del Abismo\u2026 nuestro hogar. Tan lejos\u2026
      tan cerca\u2026\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Debes escapar, ni\xF1o. Escapa de este lugar y vuelve a casa.\r"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Para lograrlo tendr\xE1s que atravesar todas las instalaciones\u2026
      y recolectar los ShadowShards.\r"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "\xBFPor qu\xE9? No lo s\xE9. Escuch\xE9 a unos cient\xEDficos hablar
      de ellos\u2026 como si fueran la llave de algo.\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Ahora ve, ni\xF1o\u2026\r\nVe y cumple tu destino antes de que las luces
      nos apaguen a todos."
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  accionFinal:
    tipo: 0
    habilidad: 0
    objetoActivar: {fileID: 0}
    activar: 1
    sonido: {fileID: 0}
    idPuerta: 
