  m_Script: {fileID: 11500000, guid: f28f1ba5ca3e0d74c918894bf572cad2, type: 3}
  m_Name: DialogoUmbra
  m_EditorClassIdentifier: 
  idDialogo: 
  lineas:
  - texto: "Mmm\u2026 \xBFqu\xE9 tenemos aqu\xED? T\xFA debes ser Shawy. Noxel te
      mencion\xF3.\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Mi nombre es Umbra. Guardi\xE1n del reflejo. Y como t\xFA, estoy atrapado
      aqu\xED.\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Voy a ense\xF1arte un poder peque\xF1o, pero esencial para tu camino.\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Como ya sabr\xE1s, la luz es nuestra enemiga desde hace siglos. Y por
      eso\u2026\r\n"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Hemos creado los MirrorBlocks: fragmentos de sombra endurecida capaces
      de desviar la luz.\r"
    retrato: {fileID: 0}
    nombreNPC: 
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  accionFinal:
    tipo: 0
    habilidad: 1
    objetoActivar: {fileID: 0}
    activar: 1
    sonido: {fileID: 0}
    idPuerta: 
