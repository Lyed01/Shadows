  m_Name: Sillhuette1
  m_EditorClassIdentifier: 
  idDialogo: 
  lineas:
  - texto: "Oh\u2026 \xBFqu\xE9 tal, peque\xF1\xEDn? He estado observando c\xF3mo
      avanzas por las instalaciones. "
    retrato: {fileID: 0}
    nombreNPC: Sillhuette
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Me has sorprendido m\xE1s de lo que imagin\xE1s. Quiz\xE1s tengas m\xE1s
      talento del que aparentas."
    retrato: {fileID: 0}
    nombreNPC: Sillhuette
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Casi lo olvido\u2026 soy Silhuette. Otra sombra atrapada aqu\xED, igual
      que t\xFA.\r"
    retrato: {fileID: 0}
    nombreNPC: Sillhuette
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "A veces, cuando est\xE1s encerrada demasiado tiempo, descubr\xEDs formas
      nuevas de moverte.\r"
    retrato: {fileID: 0}
    nombreNPC: Sillhuette
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  - texto: "Te voy a ense\xF1ar una..."
    retrato: {fileID: 0}
    nombreNPC: Sillhuette
    accionPorLinea:
      tipo: 0
      habilidad: 0
      objetoActivar: {fileID: 0}
      activar: 0
      sonido: {fileID: 0}
      idPuerta: 
  accionFinal:
    tipo: 0
